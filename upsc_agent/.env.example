# Groq API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key

# Telegram Bot Token & Chat ID
# Create bot at t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Get your Chat ID or Channel ID (e.g., using @userinfobot or checking group/channel details)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Meta/Instagram Graph API Settings
# Get Access Token from Meta Developer Portal -> Graph API Explorer
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
# Get Account ID for the Instagram Business Account linked to your Page
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id

# Instagram page handle (e.g., @yourupscpage)
UPSC_IG_HANDLE=@yourupscpage

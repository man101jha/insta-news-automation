# =====================================================================
# CONFIGURATION TEMPLATE FOR FINANCE AGENT
# Copy this file to '.env' and fill in your actual credentials.
# =====================================================================

# --- GROQ LLM API (For filtering & copywriting) ---
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- REDDIT API (For r/IndiaInvestments scraping) ---
# Create an app at: https://www.reddit.com/prefs/apps
# Choose "script" as the application type.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=finance-carousel-bot/1.0 by /u/your_reddit_username

# --- CANVA CONNECT API ---
# Create an integration at: https://www.canva.dev/
# Canva Connect API requires access tokens for authentication.
CANVA_ACCESS_TOKEN=your_canva_connect_access_token
# Optional: Canva Brand Template ID if using Autofill API (Enterprise only)
CANVA_BRAND_TEMPLATE_ID=your_brand_template_id

# --- TELEGRAM BOT (For approval workflow) ---
# Create a bot using @BotFather on Telegram to get your token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Get your personal Chat ID using @userinfobot or similar on Telegram.
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- INSTAGRAM GRAPH API (For publishing carousels) ---
# Requires a Facebook Developer account, a Facebook Page linked to your
# Instagram Professional/Business Account.
# Guide: https://developers.facebook.com/docs/instagram-api/getting-started/
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# Facebook Page/User long-lived access token with instagram_basic & instagram_content_publish scopes
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token
